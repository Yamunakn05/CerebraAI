# .env.example
# ============================================================
# NeuroAI Environment Variables (copy to .env and fill in)
# ============================================================

# ── Optional: Firebase Integration ────────────────────────
# FIREBASE_API_KEY=your-firebase-api-key
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com

# ── Optional: MongoDB Integration ─────────────────────────
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/braintumorai

# Required when running flask_app.py. Generate a long random value and keep it secret.
# FLASK_SECRET_KEY=replace-with-a-long-random-secret
# SESSION_COOKIE_SECURE=true

# ── Optional: AI API Keys ──────────────────────────────────
# GROQ_API_KEY=gsk_...            (for Medicine Intelligence Center)
# OPENAI_API_KEY=sk-...          (for LLM chatbot upgrade)
# GEMINI_API_KEY=AIza...         (for Gemini chatbot upgrade)

# ── App Config ─────────────────────────────────────────────
# SECRET_KEY=your-secret-key-for-session-encryption
# DEBUG=False
# LOG_LEVEL=INFO
